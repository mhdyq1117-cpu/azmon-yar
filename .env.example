# کپی این فایل را با نام «.env» در ریشه پروژه ذخیره کنید و مقادیر را تنظیم کنید
# دیتابیس داخلی (SQLite) — مسیر پیش‌فرض نیازی به تغییر ندارد
DATABASE_URL=file:../db/custom.db

# پروژه Supabase شما (برای ورود و ثبت‌نام معلمان)
# از بخش Settings → API در پنل Supabase بردارید
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
